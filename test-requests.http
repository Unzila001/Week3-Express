
### Get all cats
GET http://127.0.0.1:3000/api/v1/cats

### Get one cat
GET http://127.0.0.1:3000/api/v1/cats/9592


### Add a new cat
POST http://127.0.0.1:3000/api/v1/cats
Content-Type: application/json

{
  "cat_name": "Luna",
  "weight": 4,
  "owner": 3609,
  "filename": "luna.jpg",
  "birthdate": "2023-06-15"
}


### Update a cat
PUT http://127.0.0.1:3000/api/v1/cats/9592


### Delete a cat
DELETE http://127.0.0.1:3000/api/v1/cats/9592


### Get all users
GET http://127.0.0.1:3000/api/v1/users

### Get one user by ID
GET http://127.0.0.1:3000/api/v1/users/3609


### Add a new user
POST http://127.0.0.1:3000/api/v1/users
Content-Type: application/json

{
  "name": "Alice Brown",
  "username": "alicebrown",
  "email": "alice@metropolia.fi",
  "role": "user",
  "password": "test123"
}


### Update a user
PUT http://127.0.0.1:3000/api/v1/users/3609



### Upload a cat image
POST http://127.0.0.1:3000/api/v1/cats
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Misu
--MyBoundary
Content-Disposition: form-data; name="weight"

6
--MyBoundary
Content-Disposition: form-data; name="owner"

3609
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2023-10-08
--MyBoundary
Content-Disposition: form-data; name="cat"; filename="test-cat.jpg"
Content-Type: image/jpeg

< ./test-cat.jpg
--MyBoundary--


### Add a new cat
POST http://127.0.0.1:3000/api/v1/cats
Content-Type: application/json

{
  "cat_name": "Luna",
  "weight": 3,
  "owner": 37,
  "filename": "luna.jpg",
  "birthdate": "2022-05-10"
}

### Update Luna
PUT http://127.0.0.1:3000/api/v1/cats/43
Content-Type: application/json

{
  "cat_name": "Luna",
  "weight": 4,
  "owner": 37,
  "filename": "no image",
  "birthdate": "2022-05-10"
}

### Delete Luna
DELETE http://127.0.0.1:3000/api/v1/cats/43


### Add a new user
POST http://localhost:3000/api/v1/users
Content-Type: application/json

{
  "name": "Test Student",
  "username": "teststudent",
  "email": "teststudent@example.com",
  "password": "9f50dbb288ce19a996accc6bc97e36583948440d7e2007e214dbf8bcdd3281f5",
  "role": "user"
}

### Update Test Student
PUT http://127.0.0.1:3000/api/v1/users/38
Content-Type: application/json

{
  "name": "Updated Student",
  "username": "teststudent",
  "email": "teststudent@example.com",
  "role": "user"
}

### Verify updated user
GET http://127.0.0.1:3000/api/v1/users/38